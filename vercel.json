{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/dist",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dist/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
